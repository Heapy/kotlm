# Key for /auth/* routes: subscription login and status.
KOTLM_ADMIN_KEY=replace-with-a-long-random-string

# Models that the proxy is allowed to request.
KOTLM_ALLOWED_MODELS=gpt-5.6-sol

# Project keys and their limits belong in secrets/clients.json, not here.
# Example:
# {
#   "clients": [
#     { "name": "sql-nastya", "key": "…", "requestsPerMinute": 30, "dailyTokens": 300000 }
#   ]
# }
